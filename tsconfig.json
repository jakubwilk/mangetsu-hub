{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "apps": ["./src/apps/index"],
      "apps/*": ["./src/apps/*"],
      "admin": ["./src/modules/admin/index"],
      "admin/*": ["./src/modules/admin/*"],
      "auth": ["./src/modules/auth/index"],
      "auth/*": ["./src/modules/auth/*"],
      "chat": ["./src/modules/chat/index"],
      "chat/*": ["./src/modules/chat/*"],
      "common": ["./src/modules/common/index"],
      "common/*": ["./src/modules/common/*"],
      "hub": ["./src/modules/hub/index"],
      "hub/*": ["./src/modules/hub/*"],
      "notices": ["./src/modules/notices/index"],
      "notices/*": ["./src/modules/notices/*"],
      "server/*": ["./src/server/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
