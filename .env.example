# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/mangetsu_rag
DATABASE_PASSWORD=password

# OVH AI Endpoints (fallback — używany automatycznie, gdy LLM_AI zawiedzie)
# Każdy model ma osobny URL - pobierz z panelu OVH Public Cloud > AI Endpoints
OVH_AI_ENDPOINT=https://your-llm-endpoint.ai-endpoints.kepler.ai.cloud.ovh.net/v1
OVH_AI_API_KEY=your-ovh-api-key
OVH_AI_MODEL=ovh-fallback-model

# Embedding model (osobny endpoint)
OVH_AI_EMBEDDING_ENDPOINT=https://your-embedding-endpoint.ai-endpoints.kepler.ai.cloud.ovh.net/v1
OVH_AI_EMBEDDING_MODEL=ovh-embedding-model

# LLM AI Endpoints (primary — obsługuje komunikację z użytkownikiem)
# Akceptowany URL zakończony na /v1 lub na /v1/chat/completions (normalizowane automatycznie)
LLM_AI_ENDPOINT=https://your-llm-endpoint.api.mistral.ai/v1/chat/completions
LLM_AI_API_KEY=your-llm-api-key
LLM_AI_MODEL=main-llm-model

# Rate limiting
DAILY_REQUEST_LIMIT=20

# External forum link
NEXT_PUBLIC_FORUM_URL=

# Auth (Discord OAuth) — wygeneruj AUTH_SECRET komendą: npx auth secret
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_TRUST_HOST=true
# Kanoniczny URL aplikacji — dev: http://localhost:3000, prod: pełny URL z Coolify (bez trailing slash)
AUTH_URL=http://localhost:3000

# n8n webhooks — panel administracyjny (aktywacja konta / usunięcie konta)
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.example.com/webhook
N8N_WEBHOOK_SECRET=
N8N_ROLE_ACTIVATION_WEBHOOK_PATH=
N8N_USER_DELETION_WEBHOOK_PATH=

# Webhook automatyzacji do zgłaszania nowych źródeł (panel "Dodaj źródło")
SOURCES_WEBHOOK_URL=https://your-automation-instance.example.com/api/v1/webhooks/your-webhook-id/sync
