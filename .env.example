# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/mangetsu_hub
DATABASE_PASSWORD=password

# Embedding model
LLM_AI_EMBEDDING_ENDPOINT=https://your-embedding-endpoint.ai-endpoints.kepler.ai.cloud.ovh.net/v1
LLM_AI_EMBEDDING_API_KEY=your-embedding-api-key
LLM_AI_EMBEDDING_MODEL=embedding-model

# LLM AI Endpoints (primary — obsługuje komunikację z użytkownikiem)
# Akceptowany URL zakończony na /v1 lub na /v1/chat/completions (normalizowane automatycznie)
LLM_MAIN_AI_ENDPOINT=https://your-llm-endpoint.api.mistral.ai/v1/chat/completions
LLM_MAIN_AI_API_KEY=your-llm-api-key
LLM_MAIN_AI_MODEL=main-llm-model

# Secondary AI Endpoints (fallback — używany automatycznie, gdy LLM_MAIN_AI zawiedzie)
LLM_FALLBACK_AI_ENDPOINT=https://your-llm-endpoint.ai-endpoints.kepler.ai.cloud.ovh.net/v1
LLM_FALLBACK_AI_API_KEY=your-ovh-api-key
LLM_FALLBACK_AI_MODEL=ovh-fallback-model

# Rate limiting — dzienny limit zapytań na użytkownika, liczony osobno dla każdej mini-apki z RAG-iem
DAILY_REQUEST_LIMIT=20

# External forum link
NEXT_PUBLIC_FORUM_URL=

# Auth (Discord OAuth) — wygeneruj AUTH_SECRET komendą: npx auth secret
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_TRUST_HOST=true
# Kanoniczny URL aplikacji — dev: http://localhost:3000, prod: pełny URL z Coolify (bez trailing slash)
# (bez trailing slash). Przy https:// cookies sesji dostają prefiks __Host- (izolacja od innych
# subdomen) — na produkcji musi to być adres HTTPS.
AUTH_URL=http://localhost:3000

# n8n webhooks — panel administracyjny (zmiana roli w Poradnikach / usunięcie konta z huba)
N8N_WEBHOOK_BASE_URL=https://your-n8n-instance.example.com/webhook
N8N_WEBHOOK_SECRET=
N8N_ROLE_ACTIVATION_WEBHOOK_PATH=
N8N_USER_DELETION_WEBHOOK_PATH=

# Wewnętrzne API dla n8n (/api/internal/*, nagłówek "Authorization: Bearer <sekret>") — bez
# tej zmiennej API jest wyłączone. Wygeneruj: openssl rand -hex 32
INTERNAL_API_SECRET=

# Webhook automatyzacji do zgłaszania nowych źródeł (panel "Dodaj źródło")
SOURCES_WEBHOOK_URL=https://your-automation-instance.example.com/api/v1/webhooks/your-webhook-id/sync
